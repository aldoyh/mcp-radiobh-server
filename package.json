{
  "name": "mcp-radiobh-server",
  "version": "1.0.0",
  "description": "MCP server for Radio BH podcast assistant with deep knowledge of shows, episodes, and topics since 1997. Expert in Laravel, PHP, TypeScript, React, Node.js and more.",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "mcp-radiobh-server": "build/index.js"
  },
  "scripts": {
    "build": "next build && tsc -p tsconfig.stdio.json && chmod 755 build/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "dev:vercel": "next dev",
    "build:vercel": "next build",
    "start:vercel": "next start"
  },
  "keywords": [
    "mcp",
    "radio-bh",
    "podcast",
    "coding-assistant",
    "laravel",
    "php",
    "typescript",
    "react",
    "nodejs"
  ],
  "author": "Radio BH Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldoyh/mcp-radiobh-server.git"
  },
  "bugs": {
    "url": "https://github.com/aldoyh/mcp-radiobh-server/issues"
  },
  "homepage": "https://github.com/aldoyh/mcp-radiobh-server#readme",
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.10.2",
    "groq-sdk": "^0.3.3",
    "zod": "^3.23.8",
    "@vercel/mcp-adapter": "^0.3.1",
    "next": "^14.2.3",
    "redis": "^4.6.13"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@10.9.0+sha512.0486e394640d3c1fb3c9d43d49cf92879ff74f8516959c235308f5a8f62e2e19528a65cdc2a3058f587cde71eba3d5b56327c8c33a97e4c4051ca48a10ca2d5f"
}
